# Local-run values for every variable in src/shared/config.py.
# Copy to .env (gitignored) in the directory you start a service from.
# Real environment variables override these; Kubernetes sets them from the manifests.

# --- Postgres (router, scripts, Alembic) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=model_registry
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# --- RabbitMQ (gateway, router, worker) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=change-me
MIDDLEWARE_QUEUE=router.requests

# --- Gateway ---
RPC_TIMEOUT_SECONDS=300

# --- Router ---
CATALOG_REFRESH_SECONDS=30

# --- Classifiers (router) ---
# DOMAIN_CHECKPOINT=src/router/checkpoints/laya-domain-v4
# COMPLEXITY_CHECKPOINT=src/router/checkpoints/laya-complexity-v2
CLASSIFIER_DEVICE=cpu
COMPLEXITY_THRESHOLD=0.5

# --- Worker ---
MODEL_NAME=gemma3:1b
ENGINE_TYPE=ollama
INFERENCE_HOST=http://localhost:11434
WORKER_PREFETCH=1
