# The LLM judge for judge_retrieval.py (any OpenAI-compatible server).
# Copy to .env (git-ignored) and fill in. A variable set in the shell wins over this file.
GLM_BASE_URL=https://<GLM_HOST>/v1
GLM_API_KEY=<GLM_API_KEY>
GLM_MODEL=glm-5.3
# true = skip TLS certificate checks (self-signed / internal certificate). Insecure.
GLM_INSECURE=true
